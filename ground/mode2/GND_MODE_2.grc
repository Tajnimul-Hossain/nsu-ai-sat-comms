    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1488, 64.0]
    rotation: 0
    state: enabled

blocks:
- name: Sensitivity
  id: variable
  parameters:
    comment: ''
    value: 2*numpy.pi*3000/samp_rate
